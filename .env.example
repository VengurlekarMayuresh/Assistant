# ─── LLM (Google GenAI) ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash
# Raises API rate limit from 60 → 5000 requests/hour
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_personal_access_token

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────
# 1. Sign up free at: https://cloud.mongodb.com
# 2. Create a cluster → Connect → Drivers → copy the connection string
# 3. Replace <user>, <password>, <cluster> with your values
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/repomind?retryWrites=true&w=majority
MONGODB_DB_NAME=repomind

# ─── Qdrant Cloud ─────────────────────────────────────────────────────────
# 1. Sign up free at: https://cloud.qdrant.io
# 2. Create a cluster → Open Dashboard → copy Cluster URL and generate API Key
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key

# ─── Neo4j AuraDB ──────────────────────────────────────────────────────────
# 1. Sign up free at: https://console.neo4j.io
# 2. Create an AuraDB Free instance → copy Connection URI and password
# URI format is always: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_auradb_instance_password

# ─── LangSmith Tracing (optional) ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=repomind-ai

# ─── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
